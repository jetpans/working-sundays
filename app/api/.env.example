FLASK_ENV=production
DEBUG=false
PORT=5000
WORKSPACE_ROOT=/app
RUNS_DIR=/app/api/jobs
LEGACY_RUNS_DIR=/app/api/runs
AUTH_DIR=/app/api/auth
AUTH_USERS_FILE=/app/api/auth/users.json

# JWT Configuration (required in production)
JWT_SECRET_KEY=your-secret-key-change-me-in-production-min-32-bytes
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# Java/Python Solver paths
JAVA_BIN=java
JAVA_JAR=/app/api/algorithm.jar
PYTHON_BIN=python

# CORS and allowed origins
ALLOWED_ORIGINS=http://localhost:3001,https://sundays.jetpans.com

# Metrics sampling
METRICS_SAMPLE_SECONDS=1.0
