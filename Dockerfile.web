# Multi-stage build for Next.js frontend (minimal runtime)
# Builder: install dev deps and build app
FROM node:20-alpine AS builder
WORKDIR /app/web

# NEXT_PUBLIC_API_SERVER is optional; defaults to sundays.jetpans.com
# Can be overridden at build time: docker build --build-arg NEXT_PUBLIC_API_SERVER=localhost:5000 .
ARG NEXT_PUBLIC_API_SERVER=sundays.jetpans.com
ENV NEXT_PUBLIC_API_SERVER=${NEXT_PUBLIC_API_SERVER}

# Copy frontend sources into /app/web
COPY app/web/package*.json ./
COPY app/web/ ./

# Diagnostic: ensure files exist (helpful for CI builds)
# RUN ls -la /app/web || true

RUN npm ci && npm run build

# Runtime: install only production deps and copy build output
FROM node:20-alpine AS runner
WORKDIR /app/web
ENV NODE_ENV=production

# Install production dependencies only (smaller final image)
COPY app/web/package*.json ./
RUN npm ci --production

# Copy built artifacts from builder (they live under /app/web in the builder stage)
COPY --from=builder /app/web/.next .next
COPY --from=builder /app/web/public ./public
COPY --from=builder /app/web/next.config.ts ./next.config.ts

EXPOSE 3000

# Run as unprivileged user
USER node

CMD ["npm", "start"]
